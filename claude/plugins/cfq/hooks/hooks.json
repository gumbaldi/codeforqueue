{
  "description": "cfq host dependency check — warns when a required command (jq, git, ...) is missing",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/cfq",
            "args": ["doctor", "hook"]
          }
        ]
      }
    ]
  }
}
